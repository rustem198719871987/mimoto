# Скопируйте в .env и заполните: cp .env.example .env

# Домен сайта без https:// (DNS-запись A должна указывать на IP сервера)
DOMAIN=mimoto.ru
# Адрес для Caddy: домен с www — HTTPS выпускается сам. Без домена: SITE_ADDRESS=":80" (сайт по IP)
SITE_ADDRESS="mimoto.ru, www.mimoto.ru"

# Пароль входа в админку (/admin). Длинный и случайный, минимум 10 символов.
ADMIN_PASSWORD=
# Секрет для подписи сессий. Сгенерируйте: openssl rand -hex 32
SESSION_SECRET=
